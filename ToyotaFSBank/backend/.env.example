# Get your Plaid API keys from the dashboard: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# Use 'sandbox' to test with fake credentials in Plaid's Sandbox environment.
# Use 'production' to use real data (requires approval from Plaid).
PLAID_ENV=sandbox

# Comma-separated list of Plaid products to request when creating a Link token.
# See https://plaid.com/docs/api/link/#link-token-create-request-products
PLAID_PRODUCTS=transactions

# Comma-separated list of country codes to show institutions from.
PLAID_COUNTRY_CODES=US

# Optional OAuth redirect URI. Leave blank unless an institution requires it.
PLAID_REDIRECT_URI=
